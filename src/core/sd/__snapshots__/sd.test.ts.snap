exports[`A1111 payload builder > txt2img with ControlNet units 1`] = `
{
  "body": {
    "alwayson_scripts": {
      "controlnet": {
        "args": [
          {
            "control_mode": "Balanced",
            "enabled": true,
            "guidance_end": 1,
            "guidance_start": 0,
            "image": "depth.png",
            "model": "control_v11f1p_sd15_depth.pth",
            "module": "none",
            "pixel_perfect": false,
            "processor_res": 512,
            "resize_mode": "Just Resize",
            "weight": 0.8,
          },
          {
            "control_mode": "Balanced",
            "enabled": true,
            "guidance_end": 0.8,
            "guidance_start": 0.1,
            "image": "canny.png",
            "model": "control_v11p_sd15_canny.pth",
            "module": "none",
            "pixel_perfect": false,
            "processor_res": 512,
            "resize_mode": "Just Resize",
            "weight": 0.5,
          },
        ],
      },
    },
    "batch_size": 1,
    "cfg_scale": 6.5,
    "height": 512,
    "n_iter": 1,
    "negative_prompt": "blurry",
    "override_settings": {
      "sd_model_checkpoint": "sd15/realisticVision.safetensors",
    },
    "override_settings_restore_afterwards": false,
    "prompt": "a castle",
    "save_images": false,
    "seed": 1234,
    "send_images": true,
    "steps": 25,
    "width": 768,
  },
  "endpoint": "/sdapi/v1/txt2img",
}
`;

exports[`ComfyUI workflow builder > img2img + inpaint mask, no ControlNet 1`] = `
{
  "ckpt": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "sd15/realisticVision.safetensors",
    },
  },
  "decode": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "sampler",
        0,
      ],
      "vae": [
        "ckpt",
        2,
      ],
    },
  },
  "init_image": {
    "_meta": {
      "title": "Init image",
    },
    "class_type": "LoadImage",
    "inputs": {
      "image": "init.png",
    },
  },
  "init_latent": {
    "class_type": "VAEEncode",
    "inputs": {
      "pixels": [
        "init_image",
        0,
      ],
      "vae": [
        "ckpt",
        2,
      ],
    },
  },
  "mask": {
    "class_type": "ImageToMask",
    "inputs": {
      "channel": "red",
      "image": [
        "mask_image",
        0,
      ],
    },
  },
  "mask_image": {
    "_meta": {
      "title": "Inpaint mask",
    },
    "class_type": "LoadImage",
    "inputs": {
      "image": "mask.png",
    },
  },
  "masked_latent": {
    "class_type": "SetLatentNoiseMask",
    "inputs": {
      "mask": [
        "mask",
        0,
      ],
      "samples": [
        "init_latent",
        0,
      ],
    },
  },
  "neg": {
    "_meta": {
      "title": "Negative",
    },
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "ckpt",
        1,
      ],
      "text": "blurry",
    },
  },
  "pos": {
    "_meta": {
      "title": "Positive",
    },
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "ckpt",
        1,
      ],
      "text": "a castle",
    },
  },
  "sampler": {
    "class_type": "KSampler",
    "inputs": {
      "cfg": 6.5,
      "denoise": 0.6,
      "latent_image": [
        "masked_latent",
        0,
      ],
      "model": [
        "ckpt",
        0,
      ],
      "negative": [
        "neg",
        0,
      ],
      "positive": [
        "pos",
        0,
      ],
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "seed": 1234,
      "steps": 25,
    },
  },
  "save": {
    "class_type": "SaveImage",
    "inputs": {
      "filename_prefix": "Darkroom",
      "images": [
        "decode",
        0,
      ],
    },
  },
}
`;

