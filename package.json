{
  "name": "darkroom",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist-electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "snap": "node scripts/snap.mjs",
    "electron:dev": "node scripts/electron-dev.mjs",
    "electron:compile": "node scripts/build-electron.mjs",
    "electron:build": "tsc -b && vite build --mode electron --outDir dist-app && node scripts/build-electron.mjs && electron-builder --mac --universal --publish never",
    "electron:build:arm64": "tsc -b && vite build --mode electron --outDir dist-app && node scripts/build-electron.mjs && electron-builder --mac dmg zip --arm64 --publish never",
    "electron:build:x64": "tsc -b && vite build --mode electron --outDir dist-app && node scripts/build-electron.mjs && electron-builder --mac dmg zip --x64 --publish never",
    "electron:icon": "node scripts/make-icns.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@mediapipe/tasks-vision": "0.10.35",
    "@xyflow/react": "^12.12.1",
    "codemirror": "^6.0.2",
    "fflate": "^0.8.3",
    "immer": "^11.2.9",
    "libraw-wasm": "^1.6.0",
    "marked": "^15.0.12",
    "mediabunny": "^1.65.2",
    "onnxruntime-web": "^1.31.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "oxlint": "^1.90.0",
    "playwright": "^1.64.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "description": "Node-based, shader-based image editor: wire up GPU nodes to make photos look like they came from old cameras.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Bloxmine/darkroom.git"
  },
  "build": {
    "appId": "io.bloxmine.darkroom",
    "productName": "Darkroom",
    "copyright": "Darkroom contributors",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist-app/**/*",
      "dist-electron/**/*",
      "!dist-electron/*.map",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "dist-native/darkroom-coreml",
        "to": "darkroom-coreml",
        "filter": [
          "darkroom-coreml",
          "darkroom-coreml.json"
        ]
      }
    ],
    "asar": true,
    "npmRebuild": false,
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.photography",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "identity": null,
      "hardenedRuntime": false,
      "darkModeSupport": true,
      "minimumSystemVersion": "13.0",
      "mergeASARs": true,
      "extendInfo": {
        "NSCameraUsageDescription": "Darkroom uses the camera for live webcam input nodes.",
        "NSMicrophoneUsageDescription": "Darkroom may record audio together with webcam video.",
        "UTExportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "io.bloxmine.darkroom.project",
            "UTTypeDescription": "Darkroom Project",
            "UTTypeConformsTo": [
              "public.json",
              "public.data"
            ],
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "darkroom"
              ],
              "public.mime-type": [
                "application/x-darkroom-project"
              ]
            }
          }
        ]
      },
      "x64ArchFiles": "Contents/Resources/darkroom-coreml/darkroom-coreml"
    },
    "dmg": {
      "title": "${productName} ${version}"
    },
    "fileAssociations": [
      {
        "ext": "darkroom",
        "name": "Darkroom Project",
        "description": "Darkroom Project",
        "role": "Editor",
        "rank": "Owner",
        "mimeType": "application/x-darkroom-project"
      },
      {
        "ext": [
          "jpg",
          "jpeg",
          "png",
          "webp",
          "heic",
          "heif",
          "tif",
          "tiff"
        ],
        "name": "Image",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [
          "dng",
          "cr2",
          "cr3",
          "nef",
          "arw",
          "raf",
          "orf",
          "rw2"
        ],
        "name": "Camera RAW Image",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ]
  }
}
